generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Task {
  id        String   @id @default(cuid())
  prompt    String
  status    String   @default("COMPLETED")
  result    String?
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String?
  sourceUrl String?
  createdAt DateTime @default(now())
}
